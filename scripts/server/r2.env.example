# Copy to scripts/server/r2.env (gitignored) on your laptop; send.sh installs it on the
# server as ~/.config/ckey-test/r2.env (mode 600). Create an R2 API token with
# "Object Read & Write" on bucket ckey-hardening-test (Cloudflare dashboard > R2 > API tokens).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ckey-hardening-test
